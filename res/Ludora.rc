#include <windows.h>
#include "resource.h"

// ⭐ EL ICONO DE LA APLICACION.
//
// Va el PRIMERO del archivo a proposito: el Explorador de Windows muestra como
// icono del .exe el recurso de icono con el ID numerico mas bajo, no el que
// lleve un nombre concreto. Si algun dia se anade otro icono (un documento,
// una bandeja), tiene que recibir un ID mayor que este o lo suplantaria en el
// Explorador sin que nada mas cambie.
IDI_LUDORA  ICON  "Ludora.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Ludora"
            VALUE "FileDescription",  "Ludora Engine"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "Ludora"
            VALUE "OriginalFilename", "Ludora.exe"
            VALUE "ProductName",      "Ludora Engine"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
