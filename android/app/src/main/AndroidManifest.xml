<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        PERMISOS

        Solo uno, y ni siquiera es peligroso: USE_BIOMETRIC. Android lo
        concede en la instalacion y no abre ningun dialogo.

        NO se pide INTERNET: hoy no hay servidor de Ludora al que conectarse,
        asi que pedirlo seria pedir un permiso que no se usa. Cuando exista el
        servidor, se anade aqui.

        Tampoco se pide almacenamiento: todo lo que la app guarda vive en su
        propio directorio privado, que no necesita permiso.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
        El lector de huellas no es obligatorio: sin el, la app sigue
        funcionando y se entra con correo y contrasena. `required="false"`
        evita que Google Play esconda la app a los telefonos sin sensor.
    -->
    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />

    <application
        android:name=".LudoraApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/reglas_extraccion_datos"
        android:fullBackupContent="@xml/reglas_copia_seguridad"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_nombre"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ludora">

        <!--
            Una sola Activity: toda la navegacion es Compose por dentro.
            `windowSoftInputMode=adjustResize` para que el teclado no tape los
            campos de correo y contrasena.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_nombre"
            android:theme="@style/Theme.Ludora"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
