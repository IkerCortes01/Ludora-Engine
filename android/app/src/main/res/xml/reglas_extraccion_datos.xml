<?xml version="1.0" encoding="utf-8"?>
<!--
    Lo mismo que `reglas_copia_seguridad.xml`, pero para Android 12 y
    posteriores, que usan este formato.

    `cloud-backup` es la copia a Google; `device-transfer` es el paso directo
    de un telefono viejo a uno nuevo. Se excluye todo en ambos casos, por el
    mismo motivo: la clave del keystore no viaja, asi que los datos cifrados
    con ella no servirian en el destino.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
